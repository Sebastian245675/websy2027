rules_version = '2';

// Firestore quedó fuera de uso: el sitio guarda todo en PostgreSQL (leads-api).
// Pegar estas reglas en Firebase Console > Firestore Database > Reglas > Publicar SOLO DESPUÉS de correr
// la importación (leads-api/scripts/import-firestore.js), porque la importación lee por la API pública.
// Hasta entonces, cualquiera con el ID del proyecto puede leer los leads guardados ahí.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
